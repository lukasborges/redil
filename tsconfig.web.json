{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["svelte"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"composite": true,
		"noEmit": true
	},
	"include": ["src/ui/**/*.ts", "src/ui/**/*.svelte", "src/ui/**/*.d.ts", "src/shared/**/*.ts", "src/preload/api.ts"]
}
